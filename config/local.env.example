# Rechnerspezifische Werte. Kopieren nach config/local.env (steht in .gitignore).
# Alle Werte hier sind erfunden. Ohne Datei gelten die Standards in Klammern.

# --- nur Rechner, der den geteilten GPU-Rechner per ssh steuert ---
# (scripts/remote_smoke.sh, scripts/submit_gpu.sh)
GPU_HOST=sim-box.example
# Repo-Kopie auf dem GPU-Rechner (submit_gpu.sh --sync kopiert dorthin)
REMOTE_REPO=/srv/raeumwerk/repo
# Log und Exit-Code je Job auf dem GPU-Rechner (Standard: <REMOTE_REPO>/../jobs)
REMOTE_JOBS=/srv/raeumwerk/jobs
# Weg 1: externe GPU-Warteschlange. Aufruf: $GPU_SUBMIT_CMD <name> $GPU_SUBMIT_ARGS -- '<befehl>'
# (auskommentiert lassen, dann gilt Weg 2)
#GPU_SUBMIT_CMD="/pfad/zum/gpu-submit submit"
#GPU_SUBMIT_ARGS="--prio 50"
# eigenen Eintrag zurueckziehen: $GPU_CANCEL_CMD <name> (optional)
#GPU_CANCEL_CMD="/pfad/zum/gpu-submit cancel"
# Weg 2 (Fallback): Lock-Skript mit acquire/release
GPU_LOCK=/opt/gpu-lock/gpu-lock.sh
# Abfrageabstand, hoechste Wartezeit, Pause zwischen Stuecken (Sekunden)
POLL_S=10
WAIT_MAX_S=14400
GAP_S=60

# --- Rechner, auf dem simuliert wird ---
# venvs, uv-Cache, Python, Wheels (Standard: $HOME/raeumwerk; nie im Repo)
RAEUMWERK_HOME=/srv/raeumwerk
# Smoke-JSONs und Logs (Standard: ergebnis/ im Repo-Root)
RAEUMWERK_RUNS=/srv/raeumwerk/runs/smoke
# Ergebnisse der Greifdemo (Standard: $RAEUMWERK_HOME/runs/greifen)
RAEUMWERK_GREIFEN_RUNS=/srv/raeumwerk/runs/greifen
# Ergebnisse Spuelmaschine ausraeumen (Standard: $RAEUMWERK_HOME/runs/ausraeumen)
RAEUMWERK_AUSRAEUMEN_RUNS=/srv/raeumwerk/runs/ausraeumen
# Run-Verzeichnisse von raeumwerk run (Standard: $RAEUMWERK_HOME/runs/experimente)
RAEUMWERK_EXPERIMENT_RUNS=/srv/raeumwerk/runs/experimente
# optional: eigenes HOME nur fuer den Kit-Prozess, damit Kit-/Shader-Caches nicht auf / landen
RAEUMWERK_KIT_HOME=/srv/raeumwerk/home
# Ordner fuer vortrainierte Gewichte der Erkennung (scripts/p3_modell_holen.sh; Standard $RAEUMWERK_HOME/modelle)
RAEUMWERK_MODELLE=/srv/raeumwerk/modelle

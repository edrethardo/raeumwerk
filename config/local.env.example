# Rechnerspezifische Werte. Kopieren nach config/local.env (steht in .gitignore).
# Alle Werte hier sind erfunden. Ohne Datei gelten die Standards in Klammern.

# --- nur Rechner, der den geteilten GPU-Rechner per ssh steuert (scripts/remote_smoke.sh) ---
GPU_HOST=sim-box.example
GPU_LOCK=/opt/gpu-lock/gpu-lock.sh
REMOTE_REPO=/srv/raeumwerk/repo

# --- Rechner, auf dem simuliert wird ---
# venvs, uv-Cache, Python, Wheels (Standard: $HOME/raeumwerk; nie im Repo)
RAEUMWERK_HOME=/srv/raeumwerk
# Smoke-JSONs und Logs (Standard: ergebnis/ im Repo-Root)
RAEUMWERK_RUNS=/srv/raeumwerk/runs/smoke
# optional: eigenes HOME nur fuer den Kit-Prozess, damit Kit-/Shader-Caches nicht auf / landen
RAEUMWERK_KIT_HOME=/srv/raeumwerk/home
